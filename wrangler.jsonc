{
  "name": "goldhub",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-23",
  "observability": { "enabled": true },

  // Static site (index.html, admin.html). No build step: files are served as-is.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // These paths run the Worker before static files.
    "run_worker_first": ["/api/*", "/script/*"]
  },

  // SCRIPTS must be a KV namespace binding, NOT a plain-text variable.
  // Put your namespace id here (dashboard: Storage & Databases > KV).
  "kv_namespaces": [
    { "binding": "SCRIPTS", "id": "PASTE_KV_NAMESPACE_ID_HERE" }
  ]
}
